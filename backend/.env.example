CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Hugging Face Inference API (embeddings + VLM image captioning) ---
# Get a token at https://huggingface.co/settings/tokens (read-access token is enough).
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Multilingual embedding model used for BOTH text chunks and image captions, at ingestion AND query time.
# Must stay the same model for the lifetime of a Chroma collection (changing it invalidates existing vectors).
HF_EMBEDDING_MODEL=intfloat/multilingual-e5-large
# Vision-capable chat model reachable via HF Inference Providers, used to caption extracted figures/diagrams.
HF_VLM_MODEL=Qwen/Qwen2-VL-7B-Instruct
# Which HF Inference Provider backend to route through (e.g. hf-inference, together, fireworks-ai).
HF_INFERENCE_PROVIDER=hf-inference

# --- Mistral AI (conversational LLM, native API - not via Hugging Face) ---
# Get an API key at https://console.mistral.ai/api-keys
MISTRAL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Chat model used to generate the final grounded answer.
MISTRAL_MODEL=mistral-small-latest

# --- Chroma (embedded vector store, persisted locally - no separate server) ---
# Name of the single Chroma collection holding all text chunks + image captions.
CHROMA_COLLECTION_NAME=documents
# How many chunks to retrieve per chat question before building the grounded prompt.
RAG_TOP_K=5

# --- Storage (uploaded files, extracted images, sqlite DB, and Chroma data) ---
# Base directory for all runtime data; created automatically on startup if missing.
DATA_DIR=./data

# Optional: path to a local folder with Docling's model weights (layout + tableformer),
# produced elsewhere via `docling-tools models download layout tableformer -o <dir>` and
# copied here. Set this if Hugging Face's storage CDN is blocked on this network so Docling
# never tries to download models at runtime. Leave empty to let Docling download normally.
DOCLING_ARTIFACTS_PATH=

# --- CORS (frontend origin(s) allowed to call this API) ---
# Comma-separated list; include the Vite dev server origin here, add the deployed frontend origin later.
CORS_ALLOWED_ORIGINS=http://localhost:5173
